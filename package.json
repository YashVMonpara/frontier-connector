{
  "name": "frontier-connector",
  "version": "0.2.0",
  "description": "Standalone connector and OpenAI/Anthropic-compatible local API gateway for Claude and OpenAI subscriptions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "default": "./dist/claude.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    }
  },
  "bin": {
    "frontier": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "connector.example.json",
    "THIRD_PARTY_LICENSES",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node --check web/app.js",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "verify": "npm run check && npm test && npm run check:package",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "serve": "npm run build && node dist/cli.js serve",
    "web": "npm run build && node dist/cli.js web",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashVMonpara/frontier-connector.git"
  },
  "bugs": {
    "url": "https://github.com/YashVMonpara/frontier-connector/issues"
  },
  "homepage": "https://github.com/YashVMonpara/frontier-connector#readme"
}
