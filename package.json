{
  "name": "dsh-plugin-frontier-connector",
  "version": "0.1.0",
  "description": "Local Claude and OpenAI subscription workspace powered by the complete DeepSeek Harness agent runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/claude.d.ts",
      "default": "./dist/claude.js"
    }
  },
  "bin": {
    "frontier": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "cordis.patch.yml",
    "frontier-agent.patch.yml",
    "connector.example.json",
    "THIRD_PARTY_LICENSES",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node --check web/app.js",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "verify": "npm run check && npm test && npm run check:package",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "web": "npm run build && node dist/cli.js web",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashVMonpara/frontier-connector.git"
  },
  "bugs": {
    "url": "https://github.com/YashVMonpara/frontier-connector/issues"
  },
  "homepage": "https://github.com/YashVMonpara/frontier-connector#readme"
}
